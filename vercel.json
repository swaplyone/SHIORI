{
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shiori-vw8w.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://shiori-vw8w.onrender.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
